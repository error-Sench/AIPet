# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# 开发工具产物（勿入库）
.vs/
# git worktree（并行会话副本；Hermes 等工具用，勿入库）
.worktrees/
*.old
*.old.*

# 打包产物（dist/ 里的交付物要提交，导出与压缩包不要）
dist/export/
# 导出/解包目录（版本号开头）；勿写成 AIPet-* —— Windows 下大小写不敏感，会误吞 aipet-mcp/
dist/AIPet-[0-9]*/
dist/*.zip
bin/
obj/

# 仓库卫生（打包审计 B3）
.idea/
*.DotSettings.user
steam_api64.dll
*.tmp

# 小组件运行状态（随组件目录，不入库）
mods/toolbar/*/state.json
