# 统一行尾符，避免 CRLF/LF 噪音污染 diff（Godot/C# 项目约定 LF）
* text=auto eol=lf

# 明确文本类型
*.cs        text eol=lf
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.shader    text eol=lf
*.glsl      text eol=lf
*.csv       text eol=lf
*.po        text eol=lf
*.pot       text eol=lf

# 二进制（禁止行尾转换与 diff）
*.png       binary
*.jpg       binary
*.jpeg      binary
*.webp      binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.wav       binary
*.ogg       binary
*.mp3       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.exe       binary
*.pck       binary
*.zip       binary

# Git 元数据
.gitattributes text eol=lf
.gitignore     text eol=lf